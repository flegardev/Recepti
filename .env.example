# Public project settings. Use a publishable key with RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-public-key
# Legacy deployments may use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
# Never place secret or service-role keys in NEXT_PUBLIC variables.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required server-only household membership allowlist. Keep this synchronized
# with private.configure_owner_emails(...). All admitted accounts share one
# cookbook, pantry, shopping list, history, settings, and image library.
OWNER_EMAILS=owner@example.com,second-owner@example.com

# Test-only. Never set these on a production or preview deployment.
E2E_TEST_MODE=0
